# URL da API (finance-manager-backend). Usada pelo servidor do Next (login e refresh).
API_URL=http://localhost:3000
# URL da API vista pelo navegador. O backend precisa liberar esta origem em CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3000

# NextAuth: gere o segredo com `openssl rand -base64 48`
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=
